<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!--<Version>11.3.0.22</Version>-->
    <Version>11.3.12</Version>
    <RepositoryUrl>https://github.com/nscript-site/NewBeeUI</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageId>newbeeui</PackageId>
    <PackageTags>avalonia,mvu</PackageTags>
    <PackageProjectUrl>https://github.com/nscript-site/NewBeeUI</PackageProjectUrl>
    <Copyright>geblab.com</Copyright>
    <Title>A avalonia mvu ui library for new bee</Title>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <IncludeSymbols>False</IncludeSymbols>
    <Company>geblab</Company>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="nmarkup" Version="$(nmarkupVersion)"/>
    <PackageReference Include="NStyles.MeterialIcons" Version="$(nmarkupVersion)"/>
    <PackageReference Include="Avalonia" Version="$(AvaloniaVersion)"/>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\nstyles\source\NStyles\NStyles.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Update="README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>
</Project>